APP_NAME="Desert Rose Gifts"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database — Railway provides DATABASE_URL automatically when you add a MySQL service.
# The app reads DATABASE_URL first; individual DB_* vars are the fallback.
DB_CONNECTION=mysql
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Mail — set MAIL_MAILER=smtp and the SMTP vars below for real delivery.
# With MAIL_MAILER=log, emails are written to the log instead of being sent.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_SCHEME=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Redis (optional — only if you add a Railway Redis service)
# REDIS_URL=redis://user:password@host:port
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Admin notification email (used by contact form / review notifications)
ADMIN_EMAIL=admin@desertrose.com
